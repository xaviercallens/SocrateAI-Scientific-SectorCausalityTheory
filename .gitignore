# Lean build artefacts (regenerated by: cd lean && lake exe cache get && lake build).
# lean/lake-manifest.json is deliberately COMMITTED: it pins every transitive dependency.
lean/.lake

# LaTeX intermediates (PDFs are committed; these are not)
papers/*.aux
papers/*.bbl
papers/*.blg
papers/*.log
papers/*.out
papers/*.fls
papers/*.fdb_latexmk
papers/*.toc
papers/*.synctex.gz

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# Rust (if an MCP server build lands here)
target/
